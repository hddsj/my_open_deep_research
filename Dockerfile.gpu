# ============================================
# Dockerfile.gpu (GPU 版本)
# 适用于：有 NVIDIA GPU 的服务器
# embedding 模型和 reranker 跑在 GPU 上，速度快 5-10x
# 前提：宿主机已安装 NVIDIA 驱动 + nvidia-container-toolkit
# ============================================

# ---- 基础镜像：NVIDIA CUDA 12.1 + Python 3.11 ----
FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04

# ---- 安装 Python 3.11 + 系统依赖 ----
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-venv python3-pip python3.11-dev \
    build-essential \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && ln -sf /usr/bin/pip3 /usr/bin/pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ---- 复制构建所需文件 ----
COPY pyproject.toml README.md ./
COPY src/ src/

# ---- 安装依赖（GPU 版 PyTorch + CUDA 12.1）----
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cu121 \
    && pip install --no-cache-dir "."

# ---- 复制其余文件 ----
COPY web/ web/
COPY langgraph.json .

# ---- 创建数据目录 ----
RUN mkdir -p knowledge_base chroma_db

# ---- 环境变量：让 PyTorch 自动使用 GPU ----
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

EXPOSE 8000

CMD ["uvicorn", "web.server:app", "--host", "0.0.0.0", "--port", "8000"]
